---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/Navigation.astro';
import { Content as English, getHeadings as englishHeadings } from '../content/enterprise.en.md';
import { Content as Chinese, getHeadings as chineseHeadings } from '../content/enterprise.zh.md';
import head from '../data/agent-diagrams-head.html?raw';
import articleCss from '../styles/agent-diagrams.css?raw';
import { productVersion, productChannel } from '../data/product-facts';
const { lang = 'en' } = Astro.props;
const Content = lang === 'zh' ? Chinese : English;
const sectionIds = ['answer', 'views', 'language', 'studio', 'generate', 'cli', 'limits'];
const headings = (lang === 'zh' ? chineseHeadings() : englishHeadings()).filter(heading => heading.depth === 2).map((heading, index) => ({ ...heading, slug: sectionIds[index] }));
const channel = productChannel === 'development' ? (lang === 'zh' ? '开发版' : 'development') : (lang === 'zh' ? '稳定版' : 'stable');
// The Studio brings its own theme and chrome, so the frame only gives it room.
const css = `${articleCss}
.studio-frame { display:block; width:100%; height:min(78vh, 760px); min-height:520px; margin:1.5rem 0 .6rem; border:1px solid var(--line-hi); border-radius:12px; background:var(--surface); }
.studio-open { font-size:.86rem; }
@media (max-width: 720px) { .studio-frame { height:70vh; min-height:440px; } }`;
---
<SiteLayout page="enterprise" lang={lang} head={head} css={css}>
  <div class="grid-bg" aria-hidden="true"></div>
  <Navigation page="enterprise" />
  <main class="agent-guide">
    <header class="article-meta">
      <p>{lang === 'zh' ? '企业架构 · 建模 / 生成' : 'Enterprise models · Model / generate'}</p>
      <p>{lang === 'zh' ? `Archify v${productVersion} · ${channel} · 示例模型为虚构，并非某个真实系统的记录。` : `Archify v${productVersion} · ${channel} · The example model is invented, not a record of a real system.`}</p>
    </header>
    <div class="article-grid">
      <nav class="article-toc" aria-label={lang === 'zh' ? '本页目录' : 'On this page'}>
        <p>{lang === 'zh' ? '本页目录' : 'On this page'}</p>
        <ol>{headings.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </nav>
      <article class="article-body"><Content /></article>
    </div>
  </main>
  <footer class="article-footer"><a href="agent-diagrams.html">{lang === 'zh' ? '阅读 Agent 画图指南 →' : 'Read the agent diagramming guide →'}</a><a href="guide.html">{lang === 'zh' ? '选择图表配方 →' : 'Choose a diagram recipe →'}</a><a href="start.html">{lang === 'zh' ? '开始安装 →' : 'Install Archify →'}</a></footer>
</SiteLayout>
